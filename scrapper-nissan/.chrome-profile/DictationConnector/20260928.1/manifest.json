{
  "name": "VoiceTyping Connector Extension",
  "manifest_version": 3,
  "version": "20260928.1",
  "version_name": "1.0 20260928.1",
  "key": "",
  "description": "Connector extension for VoiceTyping",
  "background": {
    "service_worker": "background_compiled.js",
    "type": "module"
  },
  "oauth2": {
    "auto_approve": true,
    "scopes": [
      "https://www.googleapis.com/auth/temporary"
    ]
  },
  "permissions": [
    "audioCapture",
    "dictationPrivate",
    "downloads",
    "identity",
    "offscreen",
    "storage",
    "systemPrivate"
  ],
  "incognito": "not_allowed",
  "message_serialization": "structured_clone"
}